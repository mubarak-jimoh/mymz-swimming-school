# Public project values from Supabase Project Settings > API.
# The anon key is designed for browser use; access is restricted by RLS.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Required for the protected booking endpoint; never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only HMAC secret used to pseudonymise rate-limit client identifiers.
# Generate a unique high-entropy value for production; never expose it to the browser.
RATE_LIMIT_HASH_SECRET=

# Cloudflare Turnstile. Both are required in production for enquiry/booking submissions.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Server-only enquiry notification configuration.
MYMZ_ENQUIRY_EMAIL=aminatoluwatoyin@yahoo.co.uk
RESEND_API_KEY=
MYMZ_FROM_EMAIL=
NEXT_PUBLIC_SITE_URL=

# Stripe remains disabled until genuine credentials and pricing are approved.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Never add a Supabase service-role key to a NEXT_PUBLIC_ variable.
